<idea-plugin>
    <dependencies>
        <module name="agent-dock.frontend"/>
        <module name="intellij.terminal.frontend"/>
        <plugin id="org.jetbrains.plugins.terminal"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceInterface="agentdock.acp.IdeTerminalBridge"
                        serviceImplementation="agentdock.acp.IdeTerminalBridgeImpl"/>
    </extensions>
</idea-plugin>
